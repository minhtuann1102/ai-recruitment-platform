# Copy thanh .env va dien key. KHONG commit .env (da nam trong .gitignore).
# Chi lenh index / search / eval can key va DB; validate / process / crawl chay offline.
# Key embedding: xin rieng nguoi giu key, khong dua vao kenh chung.
LLM_API_KEY=
# OpenRouter (OpenAI-compatible). Doi sang OpenAI truc tiep: LLM_BASE_URL=https://api.openai.com/v1
# va EMBEDDING_MODEL=text-embedding-3-small. Ten luu vao DB luon la phan sau dau "/" cuoi.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model dich + gan topic (lenh enrich)
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ai_db tu docker compose (001): localhost:5534 khi chay pipeline tren may host
AI_DB_URL=postgresql://postgres:secret@localhost:5534/ai_db

# Topic catalog cua ai-service, doc nhu du lieu (khong import code ai-service)
CATALOG_DIR=../ai-service/app/catalog

# Lenh collect tai Q&A qua GitHub API. Tuy chon: co token thi 5000 request/gio (khong co: 60/gio)
# Lay nhanh: gh auth token
GITHUB_TOKEN=
