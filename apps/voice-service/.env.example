# Copy thanh apps/voice-service/.env va dien key. KHONG commit .env (da nam trong .gitignore: **/.env).
# Service nap file nay khi khoi dong (nhu data-pipeline); bien moi truong that ghi de file. docker-compose doc cung file.
# Moi bien o day (dong khong comment hoac dong "# TEN=") dung mac dinh ghi o specs/015-voice-mode/data-model.md muc
# "Cau hinh"; test tests/test_config_matches_docs.py kiem hai ben khop nhau.

# --- Nha cung cap Blaze (key chi o phia server, khong bao gio gui ve trinh duyet) ---
BLAZE_API_KEY=
BLAZE_BASE_URL=https://api.blaze.vn

# --- Bao mat noi bo ---
# Header X-Internal-Token cho moi endpoint tru /api/health va /metrics. De trong chi dung cho dev.
# STAGING / PRODUCTION BAT BUOC dat APP_ENV=staging (hoac production) VA VOICE_SERVICE_INTERNAL_TOKEN: neu de APP_ENV=dev
# va khong co token thi service nhan moi request khong xac thuc va ai toi duoc cong 8020 deu dung duoc credit Blaze.
# APP_ENV=staging|production ma thieu token thi service tra 503 misconfigured (fail closed).
VOICE_SERVICE_INTERNAL_TOKEN=
APP_ENV=dev

# --- Mo hinh va giong ---
VOICE_STT_MODEL=blaze-stt-1.5
# refine=false giu tu dem ("ung", "kieu nhu") trong ban ghi; true co the loc mat (spike 2026-11-25)
VOICE_STT_REFINE=false
VOICE_TTS_MODEL=blaze-tts-1.5-realtime
# Danh sach giong cho phep, phan cach dau phay; phan tu dau la giong mac dinh
VOICE_TTS_VOICES=HN-Nam-2-BL

# --- Gioi han dau vao ---
VOICE_MAX_UPLOAD_MB=10
# Kiem tren moc cuoi cua tieng noi (VAD), khong phai do dai tep
VOICE_MAX_AUDIO_S=300
VOICE_MAX_TTS_CHARS=1000
# Moi thuat ngu toi da 64 ky tu (dai hon bi bo)
VOICE_MAX_KEYWORDS=100

# --- Goi nha cung cap ---
# Cung la tham so `timeout` gui cho STT (httpx cho them 5 s). STT mat ~5 s + 0.15 x do dai audio
VOICE_PROVIDER_TIMEOUT_S=30
# Chi thu lai loi ket noi, 503, 429 khong het credit (khong thu lai sau read timeout / 500 / 502 / 504: tranh tinh phi hai lan)
VOICE_PROVIDER_RETRIES=2
VOICE_PROVIDER_BACKOFF_S=0.5

# --- Chi so trinh bay ---
VOICE_LONG_PAUSE_S=1.5
VOICE_FILLERS_SUPPORTED=true
# Danh sach tu dem phan cach dau phay (de trong = mac dinh: ừm, ừ, ờ, à, ơ, kiểu như, nói chung là)
# VOICE_FILLERS=

# --- Nguong sinh nhan xet cuoi phien ---
VOICE_RATE_SLOW_SPM=100
VOICE_RATE_FAST_SPM=200
VOICE_FILLER_NOTE_RATIO=0.05
VOICE_THINKING_NOTE_S=10
