# Copy thanh apps/voice-service/.env va dien key. KHONG commit .env (da nam trong .gitignore: **/.env).
# Service nap file nay khi khoi dong (nhu data-pipeline); bien moi truong that ghi de file. docker-compose doc cung file.
# Mac dinh: docs trong specs/015-voice-mode/data-model.md muc "Cau hinh".

# --- Nha cung cap Blaze (key chi o phia server, khong bao gio gui ve trinh duyet) ---
BLAZE_API_KEY=
BLAZE_BASE_URL=https://api.blaze.vn

# --- Bao mat noi bo ---
# Header X-Internal-Token cho moi endpoint tru /api/health va /metrics. De trong chi dung cho dev:
# APP_ENV=staging|production ma thieu token thi service tra 503 misconfigured (fail closed).
VOICE_SERVICE_INTERNAL_TOKEN=
APP_ENV=dev

# --- Mo hinh va giong ---
VOICE_STT_MODEL=blaze-stt-1.5
VOICE_TTS_MODEL=blaze-tts-1.5-realtime
# Danh sach giong cho phep, phan cach dau phay; phan tu dau la giong mac dinh
VOICE_TTS_VOICES=HN-Nam-2-BL

# --- Gioi han ---
VOICE_MAX_UPLOAD_MB=10
VOICE_MAX_AUDIO_S=300
VOICE_MAX_TTS_CHARS=1000
VOICE_MAX_KEYWORDS=100

# --- Goi nha cung cap ---
# STT mat ~5 s + 0.15 x do dai audio (spike 2026-11-25); cung la tham so `timeout` gui cho STT
VOICE_PROVIDER_TIMEOUT_S=60
VOICE_PROVIDER_RETRIES=2
# true: goi VAD va STT cung luc (goi Starter chi 1 luong thi de false = tuan tu)
VOICE_PARALLEL_PROVIDER_CALLS=false

# --- Chi so trinh bay ---
VOICE_LONG_PAUSE_S=2.0
VOICE_FILLERS_SUPPORTED=true
