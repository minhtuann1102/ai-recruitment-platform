# Copy thanh .env va dien key. KHONG commit .env (da nam trong .gitignore).
# Dung OpenRouter (OpenAI-compatible). Doi sang OpenAI truc tiep: LLM_BASE_URL=https://api.openai.com/v1
# va bo tien to "openai/" trong ten model.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Model rieng tung agent (de trong thi dung LLM_MODEL):
# LLM_MODEL_CV_PARSER=  LLM_MODEL_JD_PARSER=  LLM_MODEL_PLANNER=  LLM_MODEL_EVALUATOR=  LLM_MODEL_INTERVIEWER=  LLM_MODEL_REPORTER=
# json_schema strict (true) hay json_object + kiem tra Pydantic (false) khi nha cung cap/model khong ho tro strict.
LLM_STRUCTURED_OUTPUTS=true
# Ghi noi dung prompt/output vao log (chi bat khi debug cuc bo, mac dinh tat).
LOG_LLM_IO=false
# Muc log (DEBUG | INFO | WARNING | ERROR) va dinh dang: json (mac dinh, cho he thong gom log) | text (doc tren may dev).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Tracing Langfuse (gui ca noi dung prompt / output len Langfuse, xem docs 07 muc 8.6). De trong khoa thi tat.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=false
# Che do tung agent: mock (mac dinh, khong can khoa) hoac llm. Vi du: AGENT_EVALUATOR_MODE=llm
# AGENT_CV_PARSER_MODE=mock  AGENT_JD_PARSER_MODE=mock  AGENT_PLANNER_MODE=mock
# AGENT_EVALUATOR_MODE=mock  AGENT_INTERVIEWER_MODE=mock  AGENT_REPORTER_MODE=mock
# Phien ban prompt Evaluator (trong = moi nhat, v4 trich nguon). v3 de A/B.
# EVALUATOR_PROMPT_VERSION=

# Mo phong do ttre giua cac token SSE cua mock (ms). 0 = khong tre. Dung de thu streaming qua APISIX.
MOCK_STREAM_DELAY_MS=0

# RAG duong doc (Phase 03). Bat mac dinh: thieu AI_DB_URL hay ai_db loi thi phien chay khong co RAG (agent chi dung
# key_points) va response bao loi trong metadata.rag. Dat false de tat han.
# Nen dung tai khoan chi doc; phien DB luon dat default_transaction_read_only=on.
RAG_ENABLED=true
AI_DB_URL=
# ai_db dung chung tren Supabase (DE, PR #32): AI_DB_URL = URI Session pooler cong 5432, user aie_reader; nen dat 10
# vi lan ket noi nguoi dau mat ~3 s.
# AI_DB_CONNECT_TIMEOUT_S=10
# Bat khi DE da nap textbook vao knowledge_chunks (mac dinh tat: scenario khong truy hoi, start nhanh hon ~1 s).
# RAG_TEXTBOOK_ENABLED=false
# LLM viet lai truy van sang tieng Anh o duong tim vector (ADR-010). Tat neu can bot ~1.6 s khi topic thieu Q&A.
# RAG_QUERY_REWRITE=true
# Cau hoi chinh phan technical lay tu kho interview_qa (Interviewer dien dat lai, Evaluator cham theo dap an chuan).
# RAG_QUESTION_BANK=true
# 3 request RAG loi trong 2 phut (ai_db / embedding / qua han) thi khong goi ai_db trong N giay roi thu lai; 0 = khong ngat.
# RAG_COOLDOWN_S=60
# Hybrid search: tu khoa (BM25 trong bo nho, nap corpus luc khoi dong) + vector + topic_id gop RRF.
# false = duong cu (topic_id truoc, vector khi thieu).
# RAG_HYBRID=true
# Moi next-turn (tru intro, cau kho) tim them chunk theo cau hoi + cau tra loi bang BM25 cho Evaluator (can hybrid).
# RAG_TURN_RETRIEVAL=true
# Test tich hop pgvector (pytest -m integration), tro toi DB thu, KHONG phai ai_db that:
# AI_DB_TEST_URL=postgresql://postgres:pg@localhost:5544/postgres

# Token noi bo (FR-AI-091, cung ten bien voi interview-service): interview-service gui header X-Internal-Token. De trong = khong kiem (chi dev/CI).
AI_SERVICE_INTERNAL_TOKEN=
# dev (mac dinh) | staging | production. staging/production ma thieu token thi ai-service tra 503.
APP_ENV=dev
