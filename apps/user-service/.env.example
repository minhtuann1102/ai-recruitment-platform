# App
USER_SERVICE_APP_NAME='User Service'
USER_SERVICE_APP_PORT=3301
USER_SERVICE_APP_CACHE_TTL_SECONDS=360

# Database
# db:5432 when the service runs in Docker; localhost:5534 (PG_HOST_PORT) when run on the host
USER_SERVICE_DB_HOST=db
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_USERNAME=postgres
USER_SERVICE_DB_PASSWORD=secret
USER_SERVICE_DB_CONNECTION=postgres
USER_SERVICE_DB_DATABASE=user_db
USER_SERVICE_DB_SCHEMA=public