TZ=UTC
NODE_ENV=local
FRONTEND_URL=

# Apache APISIX (API gateway)
APISIX_PROFILE=dev
APISIX_NODE_LISTEN=9080
APISIX_DEPLOYMENT_ADMIN_LISTEN=9180
# LOCAL ONLY — MUST override khi deploy (admin API bind 127.0.0.1 trong compose)
APISIX_KEY=edd1c9f034335f136f87ad84b625c8f1
APISIX_STAND_ALONE=false
ETCD_URL=http://etcd:2379
APISIX_HOMEPAGE_HOST=host.docker.internal
APISIX_HOMEPAGE_PORT=9280
APISIX_AUTH_SERVICE_HOST=host.docker.internal
APISIX_AUTH_SERVICE_PORT=3300
APISIX_USER_SERVICE_HOST=host.docker.internal
APISIX_USER_SERVICE_PORT=3301
APISIX_NOTIFICATION_SERVICE_HOST=host.docker.internal
APISIX_NOTIFICATION_SERVICE_PORT=3303
APISIX_AI_SERVICE_HOST=host.docker.internal
APISIX_AI_SERVICE_PORT=8000
APISIX_JOB_SERVICE_HOST=host.docker.internal
APISIX_JOB_SERVICE_PORT=3302
APISIX_INTERVIEW_SERVICE_HOST=host.docker.internal
APISIX_INTERVIEW_SERVICE_PORT=3304

# PostgreSQL container: one instance, one DB per service (user_db, job_db, interview_db,
# notification_db, ai_db + vector) created by scripts/init-databases.sh. Old volume: make db-ensure
DEFAULT_PG_DATABASE=user_db
DEFAULT_PG_USER=postgres
DEFAULT_PG_PASSWORD=secret
PG_HOST_PORT=5534

# MinIO container (local only). Services reach it through AWS_S3_* below.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
#REDIS_URL=localhost:6374
REDIS_URL=redis://redis:6379

#Kafka (Optional)
#KAFKA_BROKERS=localhost:9086
KAFKA_BROKERS=kafka:9092
KAFKA_HEARTBEAT_INTERVAL=2000
KAFKA_SESSION_TIMEOUT=60000
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

#RabbitMQ (Optional)
RABBITMQ_URLS=amqp://root:secret@localhost:56725

CALL_SERVICE_TIMEOUT=30000

# LOCAL ONLY — MUST override khi deploy
JWT_SECRET=S7M7O3nEa5Zks1L0NChcSiz0Xy9RCHgC1rxPjXG1hY8
JWT_ACCESS_TOKEN_EXPIRES_IN=30d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=ai-agent

#gRPC config (internal service-to-service transport)
GRPC_USER_SERVICE_HOST=0.0.0.0
GRPC_USER_SERVICE_PORT=3311
GRPC_NOTIFICATION_SERVICE_HOST=0.0.0.0
GRPC_NOTIFICATION_SERVICE_PORT=3313

#TCP config (optional, OFF by default).
# No defaults: opting a service into Transport.TCP means setting both host and
# port here, on ports that do not clash with the gRPC listeners above.
# See docs/service-communication.md
#TCP_USER_SERVICE_HOST=0.0.0.0
#TCP_USER_SERVICE_PORT=3411
#TCP_NOTIFICATION_SERVICE_HOST=0.0.0.0
#TCP_NOTIFICATION_SERVICE_PORT=3413

# AWS SES
AWS_SES_ACCESS_KEY_ID=your-access-key
AWS_SES_ACCESS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SES_SENDER=your-sender-mail
AWS_SES_REGION=ap-southeast-1

# Object storage (S3 API). Local: MinIO, bucket created by the storage-init container.
# AWS S3: STORAGE_TYPE=s3, real region, IAM keys scoped to the bucket, bucket name, bucket URL.
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=ai-recruit-files
AWS_S3_URL=http://localhost:9000
AWS_S3_CREDENTIALS_REQUIRED=true
STORAGE_TYPE=minio # storage type: s3, minio

# AI service client in NestJS: true = MockAiInterviewClient, false = RealAiInterviewClient
AI_SERVICE_MOCK=true

#SMTP
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_SECURE=true