# Bien cua compose staging (infra/staging/docker-compose.staging.yml). Tren VM: cp .env.staging.example .env; chmod 600 .env
# KHONG commit file .env that. Key LLM / Blaze / AI_DB_URL nam o env/ai-service.env va env/voice-service.env (chep tu
# apps/<service>/.env.example); bien o file nay ghi de cac file do (token, APP_ENV, SESSION_*).
# CHU Y env/ai-service.env: moi AGENT_*_MODE mac dinh mock (cau hoi theo luat, khong goi LLM) -> phai dat
# AGENT_<agent>_MODE=llm theo danh sach AIE chot; kiem /api/health `agents` khong con mock / *_config_error.

# --- Image (GHCR, CI day khi main xanh; IMAGE_TAG = ma commit 40 ky tu, hoac `main` = ban moi nhat) ---
IMAGE_REGISTRY=ghcr.io/minhtuann1102/ai-recruitment-platform
# Dat ma commit (lenh deploy tu ghi). Tag `main` doi noi dung ma `up -d` khong tu keo lai -> chi dung khi thu.
IMAGE_TAG=<sha>


# --- Ten host (Caddy). DNS: ban ghi A wildcard *.hireready (domain tuannm.app, name.com) -> IP tinh cua VM ---
# Doi domain chi can sua 3 bien nay (FR-009). Chay thu tren may: ai.localhost, voice.localhost, demo.localhost
AI_HOST=ai.hireready.tuannm.app
VOICE_HOST=voice.hireready.tuannm.app
DEMO_HOST=demo.hireready.tuannm.app
# Email dang ky Let's Encrypt (bao chung chi sap het han)
ACME_EMAIL=
# Cong tren may (mac dinh 80/443; doi khi chay thu tren may da co service chiem cong)
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Bi mat noi bo (moi bien >= 32 ky tu ngau nhien: openssl rand -hex 32) ---
# Token ai-service: backend FSD giu phia server; Caddy dung cho host demo. Khong bao gio gui ve trinh duyet.
AI_SERVICE_INTERNAL_TOKEN=
# Token voice-service: backend FSD + proxy /dev/voice cua ai-service
VOICE_SERVICE_INTERNAL_TOKEN=
# Mat khau Postgres luu phien (chi trong mang noi bo). Dung hex (openssl rand -hex 32): ky tu @ : / # lam hong
# SESSION_DB_URL. Chi co tac dung luc volume pgdata tao lan dau; doi ve sau phai ALTER USER ai_session PASSWORD '...'
POSTGRES_PASSWORD=

# --- Host demo (basic auth) ---
DEMO_USER=demo
# Hash bcrypt: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<mat-khau>'
# BAT BUOC dat trong nhay don '...': hash co ky tu $ ma compose se hieu la bien neu khong co nhay
DEMO_PASSWORD_HASH=''
