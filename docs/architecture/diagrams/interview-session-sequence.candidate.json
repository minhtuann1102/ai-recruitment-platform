  "cards": [
    {
      "dot": "cyan",
      "title": "Câu hỏi lấy từ đâu",
      "items": [
        "Câu chính topic technical: kho interview_qa (ai_db), Interviewer diễn đạt lại",
        "Topic không có câu kho, intro, scenario: Interviewer tự đặt từ topic/key_points",
        "Follow-up / hint / clarify: Interviewer sinh từ câu trả lời + focus của Evaluator",
        "reference_snippets (lúc start) + chunk theo lượt: Evaluator đối chiếu, hint dùng chunk cùng topic"
      ]
    },
    {
      "dot": "cyan",
      "title": "Nguồn và tài liệu",
      "items": [
        "Evaluator v4 gán id S1…Sn (snippet topic, rồi chunk theo lượt) và R (đáp án chuẩn)",
        "Evaluation.sources giữ ref bền (qa_id, tiêu đề, URL metadata DE)",
        "Reporter v2 chỉ chọn id; URL do code tra, LLM không thấy URL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Quan sát mỗi request",
      "items": [
        "Route mở trace Langfuse theo session_id; đóng khi stream xong hoặc client ngắt",
        "Mỗi mũi tên tới LlmGateway là một generation (prompt, output, token), gửi nền, đã che PII",
        "Log JSON không có nội dung; request_done có status, ms, token, trace id"
      ]
    },
    {
      "dot": "amber",
      "title": "Bật / tắt",
      "items": [
        "AGENT_*_MODE mặc định mock: không gọi LLM",
        "RAG_ENABLED mặc định true; lỗi → phiên chạy không RAG, metadata.rag = error | degraded",
        "Start quá hạn → giữ topic đã xong; 3 request lỗi trong 2 phút → ngắt 60 s, next-turn còn BM25 + đáp án đã cache"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kết thúc phiên",
      "items": [
        "Hết giờ / chạm turn cap → câu wrap_up",
        "Quá hạn cứng (+3 phút) → end ngay",
        "Ứng viên bấm kết thúc → interview-service gọi finalize"
      ]
    }
  ]
}