  "cards": [
    {
      "dot": "cyan",
      "title": "Câu hỏi lấy từ đâu",
      "items": [
        "Câu chính topic technical: kho interview_qa (ai_db), Interviewer diễn đạt lại",
        "Topic không có câu kho, intro, scenario: Interviewer tự đặt từ topic/key_points",
        "Follow-up / hint / clarify: Interviewer sinh từ câu trả lời + focus của Evaluator",
        "Hỏi lại vì bản ghi kém: câu cố định do code, giữ qa_id và độ khó"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lượt trả lời bằng giọng nói",
      "items": [
        "answer_source = voice: bảng tra đổi \"hát mắp\" → HashMap trước RAG, Evaluator, Interviewer; câu gõ tay giữ nguyên",
        "Rỗng / chỉ \"ừm\": 422 voice_no_speech ngay, không tốn lượt",
        "stt_confidence < 0.6: không chấm; lần đầu hỏi lại, lần hai 422 voice_unclear",
        "Hết giờ / turn cap luôn ưu tiên: lượt đi tiếp, không chấm",
        "Thuật ngữ gợi ý cho dịch vụ STT: GET /api/stt/phrases"
      ]
    },
    {
      "dot": "cyan",
      "title": "Nguồn và tài liệu",
      "items": [
        "Evaluator v8 gán id S1…Sn (snippet topic, rồi chunk theo lượt) và R (đáp án chuẩn)",
        "Evaluation.sources giữ ref bền (qa_id, tiêu đề, URL, license)",
        "Reporter chỉ chọn id; URL do code tra, chỉ nguồn CC0 / MIT / Apache / CC-BY(-SA)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Quan sát mỗi request",
      "items": [
        "Route mở trace Langfuse theo session_id; đóng khi stream xong hoặc client ngắt",
        "Mỗi mũi tên tới LlmGateway là một generation (prompt, output, token), đã che PII",
        "request_done: log JSON (không nội dung) + số liệu Prometheus ở GET /metrics"
      ]
    },
    {
      "dot": "amber",
      "title": "Bật / tắt",
      "items": [
        "AGENT_*_MODE mặc định mock: không gọi LLM",
        "RAG_ENABLED mặc định true; lỗi → phiên chạy không RAG, metadata.rag = error | degraded",
        "3 request RAG lỗi trong 2 phút → ngắt 60 s; next-turn còn BM25 + đáp án đã cache"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kết thúc phiên",
      "items": [
        "Hết giờ / chạm turn cap → câu wrap_up",
        "Middle, senior: 3 topic technical yếu liên tiếp (≥6 lượt chấm) → wrap_up sớm",
        "Quá hạn cứng (+3 phút) → end ngay",
        "Ứng viên bấm kết thúc → interview-service gọi finalize"
      ]
    }
  ]
}